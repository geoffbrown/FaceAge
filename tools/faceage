#!/usr/bin/env bash
# FaceAge — local monthly scoring pipeline.
#   faceage run [YYYY-MM-DD]   score a photo session (default: today)
#   faceage validate           re-run the reference-CSV validation
#   faceage history            show the longitudinal series
#   faceage build              rebuild the container image
#   faceage doctor             check the environment
set -euo pipefail

REPO="${FACEAGE_REPO:-$HOME/Documents/GitHub/FaceAge}"
DATA="${FACEAGE_DATA:-$HOME/FaceAgeData}"
IMAGE="${FACEAGE_IMAGE:-faceage:cpu-py36}"
MODEL="$REPO/models/faceage_model.h5"
HISTORY="$DATA/results/faceage_history.csv"
WEIGHTS_URL="https://github.com/AIM-Harvard/FaceAge/releases/download/v1/faceage_model.h5"
WEIGHTS_SHA="dd43eb66616558a70f86d55d405c2e5be1e49569654b7eb852c206393fd7a85d"

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m%s\033[0m\n' "$*"; }

ensure_colima() {
  command -v colima >/dev/null || die "colima not installed. Run: brew install colima docker"
  if ! colima status >/dev/null 2>&1; then
    info "Starting the Colima VM (first run of the day takes ~30s)..."
    colima start --vm-type=vz --vz-rosetta --cpu 4 --memory 8 --disk 60
  fi
}

ensure_model() {
  [[ -f "$MODEL" ]] || die "model weights missing at $MODEL
Download them with:
  curl -L -o '$MODEL' '$WEIGHTS_URL'"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "container image '$IMAGE' not found. Run: faceage build"
}

cmd_build() {
  ensure_colima
  info "Building $IMAGE for linux/amd64 (this takes ~10 minutes)..."
  docker build --platform linux/amd64 -f "$REPO/docker/Dockerfile" -t "$IMAGE" "$REPO"
  info "Done."
}

cmd_run() {
  # Accepts, in order of convenience:
  #   faceage run                          -> today's session folder
  #   faceage run 2026-09-06               -> that session folder
  #   faceage run ~/Desktop/pics           -> score that folder directly
  #   faceage run photo1.jpg photo2.jpg    -> stage those files into today's session
  # Any leading '-' flag ends positional parsing; the rest passes to the runner.
  local -a inputs=() passthru=()
  local replace=0 session="" session_dir=""
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--replace" ]]; then replace=1; shift; continue; fi
    if [[ "$1" == -* ]]; then passthru=("$@"); break; fi
    inputs+=("$1"); shift
  done

  local find_images=(-maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \))

  if [[ ${#inputs[@]} -eq 0 ]]; then
    session="$(date +%F)"; session_dir="$DATA/sessions/$session"
    [[ -d "$session_dir" ]] || die "no session folder at $session_dir
Create it and add photos, or pass them directly:  faceage run /path/to/*.jpg"
  elif [[ ${#inputs[@]} -eq 1 && -d "${inputs[0]}" ]]; then
    session_dir="${inputs[0]%/}"
    session="$(basename "$session_dir")"
    [[ "$session" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || session="$(date +%F)"
  elif [[ -f "${inputs[0]}" ]]; then
    session="$(date +%F)"; session_dir="$DATA/sessions/$session"
    if [[ -d "$session_dir" ]] && [[ -n "$(find "$session_dir" "${find_images[@]}" -print -quit 2>/dev/null)" ]]; then
      [[ "$replace" -eq 1 ]] || die "session $session already contains photos.
Re-run with --replace to archive them and use this set instead, or move them yourself:
  faceage run --replace <files...>"
      local archived="$DATA/sessions/${session}_replaced_$(date +%H%M%S)"
      mv "$session_dir" "$archived"
      info "Archived previous photos to $archived"
    fi
    mkdir -p "$session_dir"
    cp "${inputs[@]}" "$session_dir"/ || die "could not copy photos into $session_dir"
    info "Staged ${#inputs[@]} photo(s) into $session_dir"
  else
    session="${inputs[0]}"; session_dir="$DATA/sessions/$session"
    [[ -d "$session_dir" ]] || die "no session folder at $session_dir"
  fi

  local n
  n=$(find "$session_dir" "${find_images[@]}" 2>/dev/null | wc -l | tr -d ' ')
  [[ "$n" -gt 0 ]] || die "no .jpg/.jpeg/.png photos in $session_dir"

  ensure_colima; ensure_model; ensure_image
  mkdir -p "$DATA/results"

  info "Scoring $n photo(s) for session $session"
  docker run --rm --platform linux/amd64 \
    -v "$session_dir:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$DATA/results:/work/results" \
    "$IMAGE" \
    --mode session \
    --input /work/input \
    --session-date "$session" \
    --out-per-image "/work/results/${session}_per_image.csv" \
    --out-summary "/work/results/${session}_summary.json" \
    --history /work/results/faceage_history.csv \
    ${passthru[@]+"${passthru[@]}"} 2>&1 | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )' || true

  echo
  info "Results: $DATA/results/${session}_per_image.csv"
  info "Series : $HISTORY"
}

cmd_validate() {
  ensure_colima; ensure_model; ensure_image
  mkdir -p "$REPO/validation/runs"
  local n
  n=$(find "$REPO/validation/images" -maxdepth 1 -type f -iname '*.jpg' 2>/dev/null | wc -l | tr -d ' ')
  [[ "$n" -gt 0 ]] || die "no validation images in $REPO/validation/images (see README)"
  info "Validating against the authors' reference CSV using $n image(s)..."
  docker run --rm --platform linux/amd64 \
    -v "$REPO/validation/images:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$REPO/validation:/work/validation" \
    "$IMAGE" \
    --mode validate \
    --input /work/input \
    --reference /work/validation/reference/utk_hi-res_qa_res.csv \
    --out-per-image /work/validation/runs/reproduced.csv \
    --tolerance "${1:-1e-4}" 2>&1 | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )|localization step|estimation step'
}

cmd_history() {
  [[ -f "$HISTORY" ]] || die "no history yet at $HISTORY — run a session first"
  column -s, -t < "$HISTORY"
}

cmd_chart() {
  local out
  out=$(python3 "$REPO/tools/faceage_chart.py") || die "could not build the tracker"
  info "Tracker written to: $out"
  command -v open >/dev/null && open "$out"
}

cmd_doctor() {
  printf 'host arch        : %s\n' "$(uname -m)"
  printf 'colima           : %s\n' "$(command -v colima >/dev/null && colima status 2>&1 | head -1 || echo 'NOT INSTALLED')"
  printf 'docker           : %s\n' "$(command -v docker >/dev/null && docker --version || echo 'NOT INSTALLED')"
  printf 'image %-11s: %s\n' "$IMAGE" "$(docker image inspect "$IMAGE" >/dev/null 2>&1 && echo present || echo MISSING)"
  if [[ -f "$MODEL" ]]; then
    local sha; sha=$(shasum -a 256 "$MODEL" | cut -d' ' -f1)
    printf 'weights          : present, sha256 %s %s\n' "${sha:0:16}..." \
      "$([[ "$sha" == "$WEIGHTS_SHA" ]] && echo '(matches release v1 ✓)' || echo '(UNEXPECTED HASH)')"
  else
    printf 'weights          : MISSING (%s)\n' "$MODEL"
  fi
  printf 'photo root       : %s\n' "$DATA"
  printf 'sessions found   : %s\n' "$(ls -1 "$DATA/sessions" 2>/dev/null | wc -l | tr -d ' ')"
  printf 'history rows     : %s\n' "$([[ -f "$HISTORY" ]] && echo $(($(wc -l < "$HISTORY")-1)) || echo 0)"
}

case "${1:-}" in
  run)      shift; cmd_run "$@" ;;
  validate) shift; cmd_validate "$@" ;;
  history)  cmd_history ;;
  chart)    cmd_chart ;;
  build)    cmd_build ;;
  doctor)   cmd_doctor ;;
  *) cat <<USAGE
FaceAge — local monthly scoring pipeline

  faceage run                score today's session folder
  faceage run YYYY-MM-DD     score that session folder
  faceage run FOLDER         score a folder of photos directly
  faceage run FILE...        stage those photos into today's session and score
  faceage validate [tol]     re-run validation against the authors' CSV
  faceage history            print the longitudinal series
  faceage chart              build + open the visual tracker dashboard
  faceage build              (re)build the linux/amd64 container image
  faceage doctor             check environment, weights hash, session count

Extra flags after 'run' pass through, e.g.
  faceage run 2026-09-06 --include-flagged
  faceage run 2026-09-06 --min-face-fill 0.6
USAGE
    exit 1 ;;
esac
