#!/usr/bin/env bash
# FaceAge — local scoring pipeline.
# Data is kept per subject under $FACEAGE_DATA/subjects/<name>/, so scoring
# someone else never touches your own longitudinal series.
set -euo pipefail

REPO="${FACEAGE_REPO:-$HOME/Documents/GitHub/FaceAge}"
DATA="${FACEAGE_DATA:-$HOME/FaceAgeData}"
IMAGE="${FACEAGE_IMAGE:-faceage:cpu-py36}"
# the brightness tolerance, if one has been set with `faceage tolerance`
if [[ -f "$DATA/settings.json" ]] && [[ -z "${FACEAGE_LUMA_TOL:-}" ]]; then
  export FACEAGE_LUMA_TOL="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("luma_tol",""))' "$DATA/settings.json" 2>/dev/null)"
  export FACEAGE_LUMA_TOL_BY_CAMERA="$(python3 -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1])).get("luma_tol_by_camera",{})))' "$DATA/settings.json" 2>/dev/null)"
fi
MODEL="$REPO/models/faceage_model.h5"
DEFAULT_SUBJECT="${FACEAGE_SUBJECT:-me}"
WEIGHTS_URL="https://github.com/AIM-Harvard/FaceAge/releases/download/v1/faceage_model.h5"
WEIGHTS_SHA="dd43eb66616558a70f86d55d405c2e5be1e49569654b7eb852c206393fd7a85d"

SUBJECT="$DEFAULT_SUBJECT"; NOLOG=0
SUBJ_DIR=""; SESSIONS_DIR=""; RESULTS_DIR=""; HISTORY=""
ARGS=()

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }

# Older versions kept one subject's data at $DATA/{sessions,results}.
migrate_legacy() {
  if [[ ! -d "$DATA/subjects" ]] && { [[ -d "$DATA/sessions" ]] || [[ -d "$DATA/results" ]]; }; then
    local target="$DATA/subjects/$DEFAULT_SUBJECT"
    mkdir -p "$target"
    if [[ -d "$DATA/sessions" ]]; then mv "$DATA/sessions" "$target/sessions"; fi
    if [[ -d "$DATA/results" ]]; then mv "$DATA/results" "$target/results"; fi
    info "Moved existing data to $target (one-time layout change for multi-subject support)"
  fi
}

# Strips --subject/-s and --no-log from anywhere in the arguments; the rest
# lands in ARGS for the individual command to interpret.
parse_common() {
  ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subject=*) SUBJECT="${1#*=}"; shift ;;
      --subject|-s) [[ $# -ge 2 ]] || die "--subject needs a name"; SUBJECT="$2"; shift 2 ;;
      --no-log) NOLOG=1; shift ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
  [[ "$SUBJECT" =~ ^[A-Za-z0-9_-]{1,40}$ ]] \
    || die "invalid subject name '$SUBJECT' (letters, digits, dash, underscore)"
  # Default subject "me" but that folder is gone and exactly one person exists:
  # use them. This is what happens after renaming yourself in the app.
  if [[ "$SUBJECT" == "$DEFAULT_SUBJECT" && ! -d "$DATA/subjects/$SUBJECT" && -d "$DATA/subjects" ]]; then
    local only; only=$(find "$DATA/subjects" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$only" == "1" ]]; then
      SUBJECT="$(basename "$(find "$DATA/subjects" -maxdepth 1 -mindepth 1 -type d)")"
    fi
  fi
  SUBJ_DIR="$DATA/subjects/$SUBJECT"
  SESSIONS_DIR="$SUBJ_DIR/sessions"
  RESULTS_DIR="$SUBJ_DIR/results"
  HISTORY="$RESULTS_DIR/faceage_history.csv"
}

# With iCloud Drive's "Optimize Mac Storage" on, an evicted photo is replaced by
# a dot-prefixed `.name.jpg.icloud` placeholder. Those do not match the *.jpg
# glob, so they do not error - they silently vanish from the session and shrink
# n. Partial eviction is the dangerous case: a re-scored session would report a
# mean over 4 of 12 photos with no warning at all. Refuse instead.
check_icloud_stubs() {
  local dir="$1" stubs
  stubs=$(find "$dir" -maxdepth 1 -type f -name '.*.icloud' 2>/dev/null | wc -l | tr -d ' ')
  [[ "$stubs" -eq 0 ]] && return 0
  warn "$stubs photo(s) in this session are evicted iCloud placeholders."
  if command -v brctl >/dev/null 2>&1; then
    info "Downloading them with brctl..."
    brctl download "$dir" 2>/dev/null || true
    local remaining
    remaining=$(find "$dir" -maxdepth 1 -type f -name '.*.icloud' 2>/dev/null | wc -l | tr -d ' ')
    [[ "$remaining" -eq 0 ]] && { info "All photos are local now."; return 0; }
    die "$remaining photo(s) are still evicted after brctl download.
Scoring now would silently compute the session mean over a subset."
  fi
  die "brctl not available; cannot fetch the evicted photos.
Open the session folder in Finder to force a download, then re-run.
Scoring now would silently compute the session mean over a subset."
}

# §1 of docs/PREREGISTRATION.md: a protocol failure is recorded BEFORE the score
# is looked at. Scoring an already-invalidated session is allowed - it just will
# not enter the analysis - but it should never be a surprise.
warn_if_invalidated() {
  local session="$1" vfile="$RESULTS_DIR/session_validity.csv"
  [[ -f "$vfile" ]] || return 0
  local row
  row=$(awk -F, -v s="$session" '$1==s && tolower($2) ~ /^(no|0|false|invalid)$/ {print; exit}' "$vfile")
  [[ -n "$row" ]] || return 0
  warn "Session $session is recorded as a PROTOCOL FAILURE:"
  warn "  $(echo "$row" | cut -d, -f3-)"
  warn "It will be scored, but excluded from the pre-registered analysis."
}

# iPhones write HEIC by default, and the pipeline reads only .jpg/.jpeg/.png.
# HEIC frames are skipped with a quiet NOTE, so a 10-frame session can silently
# become a 4-frame one. Convert them instead.
#
# Conversion is a FORMAT change, not a pixel adjustment - but the encoder still
# becomes part of the instrument, so the settings are frozen here and recorded
# next to the session. Quality is pinned at 100 to keep added JPEG artefacts
# negligible. Do not change CONVERT_QUALITY once the study has started: every
# session must pass through the same encoder or they are not comparable.
#
# Originals are kept. docs/MAC_APP.md is explicit that photos are saved, not
# discarded, because the model may change and a weird session needs inspecting.
CONVERT_QUALITY=100

convert_heic() {
  local dir="$1"
  local -a heics=()
  while IFS= read -r -d '' fpath; do heics+=("$fpath"); done \
    < <(find "$dir" -maxdepth 1 -type f \( -iname '*.heic' -o -iname '*.heif' \) -print0 2>/dev/null)
  [[ ${#heics[@]} -eq 0 ]] && return 0

  command -v sips >/dev/null 2>&1 \
    || die "${#heics[@]} HEIC photo(s) here, but sips is unavailable to convert them.
Set the phone to Settings > Camera > Formats > Most Compatible so it writes
JPEG directly, and reshoot. Scoring now would silently ignore those frames."

  local orig="$dir/originals_heic"
  mkdir -p "$orig"
  info "Converting ${#heics[@]} HEIC photo(s) to JPEG (quality $CONVERT_QUALITY)..."

  local manifest="$orig/conversion.txt"
  {
    printf 'converted_at=%s\n' "$(date +%FT%T)"
    printf 'tool=sips\nquality=%s\nsource_format=heic\n' "$CONVERT_QUALITY"
    printf 'note=format conversion only; no tonal or geometric adjustment\n'
  } > "$manifest"

  local f base out
  for f in "${heics[@]}"; do
    base="$(basename "${f%.*}")"
    out="$dir/$base.jpg"
    if [[ -e "$out" ]]; then
      warn "  $base.jpg already exists; leaving the HEIC unconverted"
      continue
    fi
    sips -s format jpeg -s formatOptions "$CONVERT_QUALITY" "$f" --out "$out" \
      >/dev/null 2>&1 || die "sips failed on $f"
    printf '%s -> %s\n' "$(basename "$f")" "$base.jpg" >> "$manifest"
    mv "$f" "$orig/"
  done
  info "Originals kept in $orig"
}

ensure_colima() {
  command -v colima >/dev/null || die "colima not installed. Run: brew install colima docker"
  if ! colima status >/dev/null 2>&1; then
    info "Starting the Colima VM (first run of the day takes ~30s)..."
    colima start --vm-type=vz --vz-rosetta --cpu 4 --memory 8 --disk 60
  fi
}

ensure_model() {
  [[ -f "$MODEL" ]] || die "model weights missing at $MODEL
Download them with:
  curl -L -o '$MODEL' '$WEIGHTS_URL'"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 \
    || die "container image '$IMAGE' not found. Run: faceage build"
}

cmd_build() {
  ensure_colima
  info "Building $IMAGE for linux/amd64 (this takes ~10 minutes)..."
  docker build --platform linux/amd64 -f "$REPO/docker/Dockerfile" -t "$IMAGE" "$REPO"
  info "Done."
}

cmd_run() {
  local -a inputs=() passthru=()
  local replace=0 session="" session_dir=""
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--replace" ]]; then replace=1; shift; continue; fi
    if [[ "$1" == -* ]]; then passthru=("$@"); break; fi
    inputs+=("$1"); shift
  done

  local find_images=(-maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \))

  if [[ ${#inputs[@]} -eq 0 ]]; then
    session="$(date +%F)"; session_dir="$SESSIONS_DIR/$session"
    [[ -d "$session_dir" ]] || die "no session folder at $session_dir
Create it and add photos, or pass them directly:  faceage run /path/to/*.jpg"
  elif [[ ${#inputs[@]} -eq 1 && -d "${inputs[0]}" ]]; then
    session_dir="${inputs[0]%/}"
    session="$(basename "$session_dir")"
    [[ "$session" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || session="$(date +%F)"
  elif [[ -f "${inputs[0]}" ]]; then
    session="$(date +%F)"; session_dir="$SESSIONS_DIR/$session"
    if [[ -d "$session_dir" ]] && [[ -n "$(find "$session_dir" "${find_images[@]}" -print -quit 2>/dev/null)" ]]; then
      [[ "$replace" -eq 1 ]] || die "session $session already contains photos for subject '$SUBJECT'.
Re-run with --replace to archive them and use this set instead."
      trash_path "$session_dir" "FaceAge $SUBJECT $session (replaced $(date +%H%M%S))"
      info "Previous photos moved to the Trash"
    fi
    mkdir -p "$session_dir"
    cp "${inputs[@]}" "$session_dir"/ || die "could not copy photos into $session_dir"
    info "Staged ${#inputs[@]} photo(s) into $session_dir"
  else
    session="${inputs[0]}"; session_dir="$SESSIONS_DIR/$session"
    [[ -d "$session_dir" ]] || die "no session folder at $session_dir"
  fi

  check_icloud_stubs "$session_dir"
  convert_heic "$session_dir"

  local n
  n=$(find "$session_dir" "${find_images[@]}" 2>/dev/null | wc -l | tr -d ' ')
  [[ "$n" -gt 0 ]] || die "no .jpg/.jpeg/.png photos in $session_dir"

  warn_if_invalidated "$session"

  ensure_colima; ensure_model; ensure_image
  mkdir -p "$RESULTS_DIR"

  local -a hist_arg=()
  if [[ "$NOLOG" -eq 1 ]]; then
    warn "--no-log: scoring only, this session will NOT be added to $SUBJECT's series"
  else
    hist_arg=(--history /work/results/faceage_history.csv)
  fi

  info "Scoring $n photo(s) — subject '$SUBJECT', session $session"
  docker run --rm --platform linux/amd64 \
    -v "$session_dir:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$RESULTS_DIR:/work/results" \
    "$IMAGE" \
    --mode session \
    --input /work/input \
    --session-date "$session" \
    --out-per-image "/work/results/${session}_per_image.csv" \
    --out-summary "/work/results/${session}_summary.json" \
    ${hist_arg[@]+"${hist_arg[@]}"} \
    ${passthru[@]+"${passthru[@]}"} 2>&1 | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )' || true

  echo
  info "Results: $RESULTS_DIR/${session}_per_image.csv"
  [[ "$NOLOG" -eq 1 ]] || info "Series : $HISTORY"
}

cmd_validate() {
  ensure_colima; ensure_model; ensure_image
  mkdir -p "$REPO/validation/runs"
  local n
  n=$(find "$REPO/validation/images" -maxdepth 1 -type f -iname '*.jpg' 2>/dev/null | wc -l | tr -d ' ')
  [[ "$n" -gt 0 ]] || die "no validation images in $REPO/validation/images (see README)"
  info "Validating against the authors' reference CSV using $n image(s)..."
  docker run --rm --platform linux/amd64 \
    -v "$REPO/validation/images:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$REPO/validation:/work/validation" \
    "$IMAGE" \
    --mode validate \
    --input /work/input \
    --reference /work/validation/reference/utk_hi-res_qa_res.csv \
    --out-per-image /work/validation/runs/reproduced.csv \
    --tolerance "${1:-1e-4}" 2>&1 \
    | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )|localization step|estimation step'
}

cmd_history() {
  [[ -f "$HISTORY" ]] || die "no history yet for subject '$SUBJECT' — run a session first"
  info "Subject: $SUBJECT"
  # column(1) collapses empty fields, which silently shifts every later column;
  # fill blanks first so an undefined std (n=1) cannot misalign the table.
  awk -F, 'BEGIN{OFS=","} {for(i=1;i<=NF;i++) if($i=="") $i="-"; print}' "$HISTORY" \
    | column -s, -t
}

cmd_chart() {
  [[ -f "$HISTORY" ]] || die "no history yet for subject '$SUBJECT' — run a session first"
  local out
  out=$(FACEAGE_RESULTS="$RESULTS_DIR" FACEAGE_SUBJECT_LABEL="$SUBJECT" \
        python3 "$REPO/tools/faceage_chart.py") || die "could not build the tracker"
  info "Tracker for '$SUBJECT': $out"
  command -v open >/dev/null && open "$out"
}

# Recording a protocol failure. The ordering is the whole point: this is meant
# to be run before `faceage run`, so the decision cannot be influenced by the
# number. Refuses once the session has been scored, for exactly that reason.
cmd_invalidate() {
  local session="${1:-}" reason="${2:-}"
  [[ -n "$session" ]] || die "usage: faceage invalidate YYYY-MM-DD \"reason\" [--force]"
  [[ "$session" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "session must be YYYY-MM-DD"
  [[ -n "$reason" ]] || die "a reason is required (§1 pre-registration)"
  case "$reason" in *,*) die "reason cannot contain a comma (CSV)";; esac

  local force=0
  [[ "${3:-}" == "--force" ]] && force=1

  mkdir -p "$RESULTS_DIR"
  local vfile="$RESULTS_DIR/session_validity.csv"
  [[ -f "$vfile" ]] || echo 'session_date,valid,reason,recorded_at' > "$vfile"

  if grep -q "^$session," "$vfile" 2>/dev/null; then
    die "session $session already has a validity record in $vfile"
  fi

  if [[ -f "$HISTORY" ]] && grep -q "^$session," "$HISTORY" 2>/dev/null; then
    if [[ "$force" -eq 0 ]]; then
      die "session $session has ALREADY BEEN SCORED.
Invalidating it now is not an exclusion, it is discarding a result after seeing
it (§1). If the protocol failure was genuinely identified before the score was
looked at, re-run with --force and say so in the reason."
    fi
    warn "Recording a failure for an already-scored session, as forced."
  fi

  printf '%s,no,%s,%s\n' "$session" "$reason" "$(date +%FT%T)" >> "$vfile"
  info "Recorded protocol failure for $session: $reason"
  info "It will be excluded from the analysis, with this reason shown."
}

# B and R are study landmarks, not data. B starts the six-month clock and fixes
# where the series begins; R is the retest. Kept in the results dir so the chart
# and the analysis agree on them.
cmd_anchor() {
  local which="${1:-}" when="${2:-}"
  case "$which" in
    B|b|R|r) ;;
    '') # no args: show what is set
       local vfile="$RESULTS_DIR/anchors.csv"
       [[ -f "$vfile" ]] || { info "No anchors set for '$SUBJECT'."; return 0; }
       column -s, -t < "$vfile"; return 0 ;;
    *) die "usage: faceage anchor B|R YYYY-MM-DD" ;;
  esac
  which="$(printf '%s' "$which" | tr '[:lower:]' '[:upper:]')"
  [[ "$when" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "date must be YYYY-MM-DD"

  mkdir -p "$RESULTS_DIR"
  local vfile="$RESULTS_DIR/anchors.csv"
  [[ -f "$vfile" ]] || echo 'anchor,date,note' > "$vfile"

  if grep -q "^$which," "$vfile" 2>/dev/null; then
    local cur; cur=$(grep "^$which," "$vfile" | head -1 | cut -d, -f2)
    warn "$which is already set to $cur."
    warn "Moving it changes which sessions are in the series and refits the trend."
    read -r -p "Change $which from $cur to $when? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || die "unchanged"
    grep -v "^$which," "$vfile" > "$vfile.tmp" && mv "$vfile.tmp" "$vfile"
  fi
  printf '%s,%s,set %s\n' "$which" "$when" "$(date +%F)" >> "$vfile"
  info "Anchor $which set to $when"
}

# Session one's exposure is the baseline every later session is held to.
baseline_luma() {
  [[ -f "$HISTORY" ]] || return 0
  awk -F, 'NR>1 && $12 != "" {print $12; exit}' "$HISTORY"
}

cmd_preflight() {
  local session="${1:-$(date +%F)}"
  local per_image="$RESULTS_DIR/${session}_per_image.csv"
  [[ -f "$per_image" ]] || die "no QA data for session $session.
Pre-flight reads the per-image QA the pipeline writes, so run this after
'faceage run' for now. A detect-only mode that produces QA without a score
is the next step."
  local -a b=()
  local bl; bl="$(baseline_luma)"
  [[ -n "$bl" ]] && b=(--baseline-luma "$bl")
  python3 "$REPO/tools/faceage_preflight.py" --per-image "$per_image" \
    ${b[@]+"${b[@]}"} "${@:2}"
}

# Two or more sittings side by side, frame by frame: what actually differed?
cmd_compare() {
  [[ $# -ge 2 ]] || die "usage: faceage compare DATE1 DATE2 [DATE3 ...]"
  python3 "$REPO/tools/faceage_compare.py" --results "$RESULTS_DIR" \
    --sessions-dir "$SESSIONS_DIR" "$@"
}

cmd_app() {
  info "Starting the local UI. Nothing leaves this machine."
  FACEAGE_DATA="$DATA" FACEAGE_REPO="$REPO" \
    python3 "$REPO/tools/faceage_web.py" "$@"
}

cmd_analysis() {
  [[ -f "$HISTORY" ]] || die "no history yet for subject '$SUBJECT' — run a session first"
  python3 "$REPO/tools/faceage_analysis.py" --results "$RESULTS_DIR" "$@"
}

# Move a folder to the Trash (Finder, so Put Back works), under a readable name.
trash_path() {
  local src="$1" name="${2:-$(basename "$1")}" staged
  staged="$(dirname "$src")/$name"
  [[ "$staged" == "$src" ]] || mv "$src" "$staged"
  if [[ -n "${FACEAGE_TRASH:-}" ]]; then
    mkdir -p "$FACEAGE_TRASH" && mv "$staged" "$FACEAGE_TRASH/" && return 0
  fi
  if [[ "$(uname)" == "Darwin" ]] && osascript -e "tell application \"Finder\" to delete POSIX file \"$staged\"" >/dev/null 2>&1; then
    return 0
  fi
  mkdir -p "$HOME/.Trash" 2>/dev/null && mv "$staged" "$HOME/.Trash/" && return 0
  die "could not move $staged to the Trash"
}

cmd_tidy() {
  # Move everything the app or the CLI archived inside the data folder to the
  # Trash: discarded/ bundles and *_replaced_* session folders. With --all,
  # also session folders that are not in anyone's tracker (photos that were
  # shot, maybe scored, and never added). Logs and trackers are untouched.
  local all=0; [[ "${1:-}" == "--all" ]] && all=1
  local base="$DATA/subjects" n=0
  [[ -d "$base" ]] || { info "nothing to tidy"; return 0; }
  for subj in "$base"/*/; do
    [[ -d "$subj" ]] || continue
    local who; who="$(basename "$subj")"
    for d in "$subj"discarded/*/; do
      [[ -d "$d" ]] || continue
      trash_path "${d%/}" "FaceAge $who $(basename "$d") (discarded)"; n=$((n+1))
    done
    [[ -d "$subj/discarded" ]] && rmdir "$subj/discarded" 2>/dev/null
    for d in "$subj"sessions/*_replaced_*/; do
      [[ -d "$d" ]] || continue
      trash_path "${d%/}" "FaceAge $who $(basename "$d")"; n=$((n+1))
    done
    if [[ "$all" -eq 1 ]]; then
      local hist="$subj/results/faceage_history.csv"
      for d in "$subj"sessions/*/; do
        [[ -d "$d" ]] || continue
        local label; label="$(basename "$d")"
        [[ "$label" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}[b-z]?$ ]] || continue
        if [[ -f "$hist" ]] && grep -q "^$label," "$hist"; then continue; fi
        trash_path "${d%/}" "FaceAge $who $label (not in tracker)"; n=$((n+1))
        rm -f "$subj/results/${label}_summary.json" "$subj/results/${label}_per_image.csv" "$subj/results/checklists/${label}.json"
      done
    fi
  done
  info "moved $n folder(s) to the Trash"
  [[ "$all" -eq 1 ]] || info "sessions that were shot but never added to a tracker are kept; 'faceage tidy --all' moves those too"
}

# How much does brightness actually move FaceAge on THIS face? Score one
# session's photos as they are, then brighter and darker copies, and compare.
# The answer is what a brightness tolerance should be based on.
cmd_sensitivity() {
  ensure_colima; ensure_model; ensure_image
  local session="${1:-$(date +%F)}"
  local session_dir="$SESSIONS_DIR/$session"
  [[ -d "$session_dir" ]] || die "no session folder at $session_dir"
  local work="$DATA/sensitivity/$SUBJECT/$session"
  mkdir -p "$work"
  local gains="${SENS_GAINS:-0.90 0.95 1.05 1.10}"
  info "Sensitivity test on $session for '$SUBJECT': gains 1.00 $gains"
  score_folder_quiet "$session_dir" "$work/g1.00" "$session"
  for g in $gains; do
    local out="$work/photos_g$g"
    rm -rf "$out"; mkdir -p "$out"
    docker run --rm --platform linux/amd64 \
      -v "$session_dir:/work/input:ro" -v "$out:/work/output" \
      -v "$REPO/src/faceage_adjust.py:/work/adjust.py:ro" \
      --entrypoint python "$IMAGE" /work/adjust.py --input /work/input --output /work/output --gain "$g" \
      2>&1 | grep -vE '^(WARNING:|[0-9]{4}-)' || true
    score_folder_quiet "$out" "$work/g$g" "$session"
  done
  python3 - "$work" "$RESULTS_DIR" "$session" <<'PY'
import glob, json, os, sys, csv
work, results, session = sys.argv[1:4]
rows = []
for sf in sorted(glob.glob(os.path.join(work, 'g*_summary.json'))):
    g = float(os.path.basename(sf)[1:-len('_summary.json')])
    d = json.load(open(sf))
    if d.get('mean') is None: continue
    rows.append((g, d.get('luma'), d['mean'], d.get('n')))
base = [r for r in rows if abs(r[0]-1.0) < 1e-6]
if not base: sys.exit('the unmodified session did not score')
b = base[0]
print('')
print('  gain   brightness   FaceAge   change     (%s, %d photos)' % (session, b[3] or 0))
for g, luma, mean, n in rows:
    print('  %.2f   %9.1f   %7.2f   %+6.2f' % (g, luma if luma is not None else float('nan'), mean, mean - b[2]))
spread = max(abs(r[2]-b[2]) for r in rows)
lumas = [r[1] for r in rows if r[1] is not None]
print('')
print('  Across a brightness range of %.0f to %.0f, FaceAge moved by at most %.2f years.' % (min(lumas), max(lumas), spread))
sig = None
try:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(sys.argv[0]))), 'tools'))
except Exception: pass
hist = os.path.join(results, 'faceage_history.csv')
if os.path.exists(hist):
    means = [float(r['mean']) for r in csv.DictReader(open(hist)) if r.get('mean')]
    if len(means) >= 2:
        m = sum(means)/len(means); sd = (sum((x-m)**2 for x in means)/(len(means)-1))**0.5
        print('  Your sessions so far differ from each other by about %.2f years (standard deviation).' % sd)
        sig = sd
out = os.path.join(results, 'sensitivity_%s.csv' % session)
with open(out, 'w', newline='') as fh:
    w = csv.writer(fh); w.writerow(['gain', 'brightness', 'faceage', 'change'])
    for g, luma, mean, n in rows: w.writerow([g, luma, mean, round(mean - b[2], 3)])
print('  Saved to %s' % out)
print('')
print('  Read it like this: if the change across that whole brightness range is small next to')
print('  the session-to-session difference, brightness is not what is moving your number, and')
print('  the tolerance can be set from this table:  faceage tolerance N "reason"')
PY
}

# Score a folder to a given summary path, quietly, never touching the tracker.
score_folder_quiet() {
  local folder="$1" prefix="$2" session="$3"
  local pdir; pdir="$(dirname "$prefix")"; local pbase; pbase="$(basename "$prefix")"
  docker run --rm --platform linux/amd64 \
    -v "$folder:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$pdir:/work/results" \
    "$IMAGE" --mode session --input /work/input --session-date "$session" \
    --out-per-image "/work/results/${pbase}_per_image.csv" \
    --out-summary "/work/results/${pbase}_summary.json" \
    2>&1 | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )|localization step|estimation step' || true
}

# The brightness tolerance every session is held to, with the reason on record.
cmd_tolerance() {
  # faceage tolerance                       show
  # faceage tolerance N "reason"            set for every camera
  # faceage tolerance N "reason" --camera "Studio Display Camera"   set for one camera
  local n="${1:-}" reason="${2:-}" camera=""
  if [[ "${3:-}" == "--camera" ]]; then camera="${4:-}"; [[ -n "$camera" ]] || die "--camera needs the camera's name as the app shows it"; fi
  local f="$DATA/settings.json"
  if [[ -z "$n" ]]; then
    python3 - "$f" <<'PY'
import json, os, sys
f = sys.argv[1]
d = json.load(open(f)) if os.path.exists(f) else {}
print('brightness tolerance: %s (default 5)' % d.get('luma_tol', 'not set'))
for cam, v in (d.get('luma_tol_by_camera') or {}).items():
    print('  %s: %s' % (cam, v))
if d.get('luma_tol_reason'): print('reason: %s' % d['luma_tol_reason'])
for cam, r in (d.get('luma_tol_reason_by_camera') or {}).items():
    print('  %s: %s' % (cam, r))
PY
    return 0
  fi
  [[ "$n" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "usage: faceage tolerance N \"reason\" [--camera \"NAME\"]"
  [[ -n "$reason" ]] || die "a reason is required: it goes on the record with the number"
  mkdir -p "$DATA"
  python3 - "$f" "$n" "$reason" "$camera" <<'PY'
import json, os, sys, datetime
f, n, reason, camera = sys.argv[1:5]
d = json.load(open(f)) if os.path.exists(f) else {}
now = datetime.datetime.now().replace(microsecond=0).isoformat()
if camera:
    d.setdefault('luma_tol_by_camera', {})[camera] = float(n)
    d.setdefault('luma_tol_reason_by_camera', {})[camera] = '%s (%s)' % (reason, now)
    print('brightness tolerance for %s set to %s' % (camera, n))
else:
    d['luma_tol'] = float(n); d['luma_tol_reason'] = reason; d['luma_tol_set_at'] = now
    print('brightness tolerance set to %s for every camera' % n)
json.dump(d, open(f, 'w'), indent=2)
PY
  info "record this in docs/PREREGISTRATION.md under Amendments if the study has started"
}

cmd_reset() {
  # Start fresh. Nothing is deleted: the whole data folder is moved aside with
  # a timestamp, so it can be looked at or restored later.
  [[ -d "$DATA" ]] || { info "nothing to reset: $DATA does not exist"; return 0; }
  local dest="$DATA.archive-$(date +%Y%m%d-%H%M%S)"
  echo "This moves ALL FaceAge data (every person, every session, the trackers)"
  echo "  from  $DATA"
  echo "  to    $dest"
  echo "Nothing is deleted. Delete the archive yourself once you are sure."
  if [[ "${1:-}" != "--yes" ]]; then
    read -r -p "Type yes to continue: " ans
    [[ "$ans" == "yes" ]] || die "not reset"
  fi
  mv "$DATA" "$dest" || die "could not move $DATA"
  info "moved to $dest"
  info "Restart 'faceage app' and add yourself again; the first session sets the new baseline."
}

cmd_subjects() {
  local base="$DATA/subjects"
  [[ -d "$base" ]] || die "no subjects yet — run a session first"
  printf '%-16s %9s %9s %10s\n' SUBJECT SESSIONS LOGGED LATEST
  local d name ns rows latest
  for d in "$base"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    ns=$(find "$d/sessions" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    if [[ -f "$d/results/faceage_history.csv" ]]; then
      rows=$(( $(wc -l < "$d/results/faceage_history.csv") - 1 ))
      latest=$(tail -1 "$d/results/faceage_history.csv" | cut -d, -f7)
    else
      rows=0; latest="—"
    fi
    printf '%-16s %9s %9s %10s\n' "$name" "$ns" "$rows" "$latest"
  done
}

cmd_doctor() {
  printf 'host arch        : %s\n' "$(uname -m)"
  printf 'colima           : %s\n' "$(command -v colima >/dev/null && colima status 2>&1 | head -1 || echo 'NOT INSTALLED')"
  printf 'docker           : %s\n' "$(command -v docker >/dev/null && docker --version || echo 'NOT INSTALLED')"
  printf 'image %-11s: %s\n' "$IMAGE" "$(docker image inspect "$IMAGE" >/dev/null 2>&1 && echo present || echo MISSING)"
  if [[ -f "$MODEL" ]]; then
    local sha; sha=$(shasum -a 256 "$MODEL" | cut -d' ' -f1)
    printf 'weights          : present, sha256 %s %s\n' "${sha:0:16}..." \
      "$([[ "$sha" == "$WEIGHTS_SHA" ]] && echo '(matches release v1 ✓)' || echo '(UNEXPECTED HASH)')"
  else
    printf 'weights          : MISSING (%s)\n' "$MODEL"
  fi
  printf 'photo root       : %s\n' "$DATA"
  printf 'active subject   : %s\n' "$SUBJECT"
  printf 'sessions found   : %s\n' "$(find "$SESSIONS_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  printf 'history rows     : %s\n' "$([[ -f "$HISTORY" ]] && echo $(($(wc -l < "$HISTORY")-1)) || echo 0)"
}

