#!/usr/bin/env bash
# FaceAge — local scoring pipeline.
# Data is kept per subject under $FACEAGE_DATA/subjects/<name>/, so scoring
# someone else never touches your own longitudinal series.
set -euo pipefail

REPO="${FACEAGE_REPO:-$HOME/Documents/GitHub/FaceAge}"
DATA="${FACEAGE_DATA:-$HOME/FaceAgeData}"
IMAGE="${FACEAGE_IMAGE:-faceage:cpu-py36}"
MODEL="$REPO/models/faceage_model.h5"
DEFAULT_SUBJECT="${FACEAGE_SUBJECT:-me}"
WEIGHTS_URL="https://github.com/AIM-Harvard/FaceAge/releases/download/v1/faceage_model.h5"
WEIGHTS_SHA="dd43eb66616558a70f86d55d405c2e5be1e49569654b7eb852c206393fd7a85d"

SUBJECT="$DEFAULT_SUBJECT"; NOLOG=0
SUBJ_DIR=""; SESSIONS_DIR=""; RESULTS_DIR=""; HISTORY=""
ARGS=()

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }

# Older versions kept one subject's data at $DATA/{sessions,results}.
migrate_legacy() {
  if [[ ! -d "$DATA/subjects" ]] && { [[ -d "$DATA/sessions" ]] || [[ -d "$DATA/results" ]]; }; then
    local target="$DATA/subjects/$DEFAULT_SUBJECT"
    mkdir -p "$target"
    if [[ -d "$DATA/sessions" ]]; then mv "$DATA/sessions" "$target/sessions"; fi
    if [[ -d "$DATA/results" ]]; then mv "$DATA/results" "$target/results"; fi
    info "Moved existing data to $target (one-time layout change for multi-subject support)"
  fi
}

# Strips --subject/-s and --no-log from anywhere in the arguments; the rest
# lands in ARGS for the individual command to interpret.
parse_common() {
  ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subject=*) SUBJECT="${1#*=}"; shift ;;
      --subject|-s) [[ $# -ge 2 ]] || die "--subject needs a name"; SUBJECT="$2"; shift 2 ;;
      --no-log) NOLOG=1; shift ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
  [[ "$SUBJECT" =~ ^[A-Za-z0-9_-]{1,40}$ ]] \
    || die "invalid subject name '$SUBJECT' (letters, digits, dash, underscore)"
  SUBJ_DIR="$DATA/subjects/$SUBJECT"
  SESSIONS_DIR="$SUBJ_DIR/sessions"
  RESULTS_DIR="$SUBJ_DIR/results"
  HISTORY="$RESULTS_DIR/faceage_history.csv"
}

# With iCloud Drive's "Optimize Mac Storage" on, an evicted photo is replaced by
# a dot-prefixed `.name.jpg.icloud` placeholder. Those do not match the *.jpg
# glob, so they do not error - they silently vanish from the session and shrink
# n. Partial eviction is the dangerous case: a re-scored session would report a
# mean over 4 of 12 photos with no warning at all. Refuse instead.
check_icloud_stubs() {
  local dir="$1" stubs
  stubs=$(find "$dir" -maxdepth 1 -type f -name '.*.icloud' 2>/dev/null | wc -l | tr -d ' ')
  [[ "$stubs" -eq 0 ]] && return 0
  warn "$stubs photo(s) in this session are evicted iCloud placeholders."
  if command -v brctl >/dev/null 2>&1; then
    info "Downloading them with brctl..."
    brctl download "$dir" 2>/dev/null || true
    local remaining
    remaining=$(find "$dir" -maxdepth 1 -type f -name '.*.icloud' 2>/dev/null | wc -l | tr -d ' ')
    [[ "$remaining" -eq 0 ]] && { info "All photos are local now."; return 0; }
    die "$remaining photo(s) are still evicted after brctl download.
Scoring now would silently compute the session mean over a subset."
  fi
  die "brctl not available; cannot fetch the evicted photos.
Open the session folder in Finder to force a download, then re-run.
Scoring now would silently compute the session mean over a subset."
}

# §1 of docs/PREREGISTRATION.md: a protocol failure is recorded BEFORE the score
# is looked at. Scoring an already-invalidated session is allowed - it just will
# not enter the analysis - but it should never be a surprise.
warn_if_invalidated() {
  local session="$1" vfile="$RESULTS_DIR/session_validity.csv"
  [[ -f "$vfile" ]] || return 0
  local row
  row=$(awk -F, -v s="$session" '$1==s && tolower($2) ~ /^(no|0|false|invalid)$/ {print; exit}' "$vfile")
  [[ -n "$row" ]] || return 0
  warn "Session $session is recorded as a PROTOCOL FAILURE:"
  warn "  $(echo "$row" | cut -d, -f3-)"
  warn "It will be scored, but excluded from the pre-registered analysis."
}

ensure_colima() {
  command -v colima >/dev/null || die "colima not installed. Run: brew install colima docker"
  if ! colima status >/dev/null 2>&1; then
    info "Starting the Colima VM (first run of the day takes ~30s)..."
    colima start --vm-type=vz --vz-rosetta --cpu 4 --memory 8 --disk 60
  fi
}

ensure_model() {
  [[ -f "$MODEL" ]] || die "model weights missing at $MODEL
Download them with:
  curl -L -o '$MODEL' '$WEIGHTS_URL'"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 \
    || die "container image '$IMAGE' not found. Run: faceage build"
}

cmd_build() {
  ensure_colima
  info "Building $IMAGE for linux/amd64 (this takes ~10 minutes)..."
  docker build --platform linux/amd64 -f "$REPO/docker/Dockerfile" -t "$IMAGE" "$REPO"
  info "Done."
}

cmd_run() {
  local -a inputs=() passthru=()
  local replace=0 session="" session_dir=""
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--replace" ]]; then replace=1; shift; continue; fi
    if [[ "$1" == -* ]]; then passthru=("$@"); break; fi
    inputs+=("$1"); shift
  done

  local find_images=(-maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \))

  if [[ ${#inputs[@]} -eq 0 ]]; then
    session="$(date +%F)"; session_dir="$SESSIONS_DIR/$session"
    [[ -d "$session_dir" ]] || die "no session folder at $session_dir
Create it and add photos, or pass them directly:  faceage run /path/to/*.jpg"
  elif [[ ${#inputs[@]} -eq 1 && -d "${inputs[0]}" ]]; then
    session_dir="${inputs[0]%/}"
    session="$(basename "$session_dir")"
    [[ "$session" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || session="$(date +%F)"
  elif [[ -f "${inputs[0]}" ]]; then
    session="$(date +%F)"; session_dir="$SESSIONS_DIR/$session"
    if [[ -d "$session_dir" ]] && [[ -n "$(find "$session_dir" "${find_images[@]}" -print -quit 2>/dev/null)" ]]; then
      [[ "$replace" -eq 1 ]] || die "session $session already contains photos for subject '$SUBJECT'.
Re-run with --replace to archive them and use this set instead."
      local archived="$SESSIONS_DIR/${session}_replaced_$(date +%H%M%S)"
      mv "$session_dir" "$archived"
      info "Archived previous photos to $archived"
    fi
    mkdir -p "$session_dir"
    cp "${inputs[@]}" "$session_dir"/ || die "could not copy photos into $session_dir"
    info "Staged ${#inputs[@]} photo(s) into $session_dir"
  else
    session="${inputs[0]}"; session_dir="$SESSIONS_DIR/$session"
    [[ -d "$session_dir" ]] || die "no session folder at $session_dir"
  fi

  local n
  n=$(find "$session_dir" "${find_images[@]}" 2>/dev/null | wc -l | tr -d ' ')
  [[ "$n" -gt 0 ]] || die "no .jpg/.jpeg/.png photos in $session_dir"

  check_icloud_stubs "$session_dir"
  warn_if_invalidated "$session"

  ensure_colima; ensure_model; ensure_image
  mkdir -p "$RESULTS_DIR"

  local -a hist_arg=()
  if [[ "$NOLOG" -eq 1 ]]; then
    warn "--no-log: scoring only, this session will NOT be added to $SUBJECT's series"
  else
    hist_arg=(--history /work/results/faceage_history.csv)
  fi

  info "Scoring $n photo(s) — subject '$SUBJECT', session $session"
  docker run --rm --platform linux/amd64 \
    -v "$session_dir:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$RESULTS_DIR:/work/results" \
    "$IMAGE" \
    --mode session \
    --input /work/input \
    --session-date "$session" \
    --out-per-image "/work/results/${session}_per_image.csv" \
    --out-summary "/work/results/${session}_summary.json" \
    ${hist_arg[@]+"${hist_arg[@]}"} \
    ${passthru[@]+"${passthru[@]}"} 2>&1 | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )' || true

  echo
  info "Results: $RESULTS_DIR/${session}_per_image.csv"
  [[ "$NOLOG" -eq 1 ]] || info "Series : $HISTORY"
}

cmd_validate() {
  ensure_colima; ensure_model; ensure_image
  mkdir -p "$REPO/validation/runs"
  local n
  n=$(find "$REPO/validation/images" -maxdepth 1 -type f -iname '*.jpg' 2>/dev/null | wc -l | tr -d ' ')
  [[ "$n" -gt 0 ]] || die "no validation images in $REPO/validation/images (see README)"
  info "Validating against the authors' reference CSV using $n image(s)..."
  docker run --rm --platform linux/amd64 \
    -v "$REPO/validation/images:/work/input:ro" \
    -v "$REPO/models:/opt/faceage/models:ro" \
    -v "$REPO/validation:/work/validation" \
    "$IMAGE" \
    --mode validate \
    --input /work/input \
    --reference /work/validation/reference/utk_hi-res_qa_res.csv \
    --out-per-image /work/validation/runs/reproduced.csv \
    --tolerance "${1:-1e-4}" 2>&1 \
    | grep -vE '^(WARNING:|[0-9]{4}-[0-9]{2}-[0-9]{2} )|localization step|estimation step'
}

cmd_history() {
  [[ -f "$HISTORY" ]] || die "no history yet for subject '$SUBJECT' — run a session first"
  info "Subject: $SUBJECT"
  # column(1) collapses empty fields, which silently shifts every later column;
  # fill blanks first so an undefined std (n=1) cannot misalign the table.
  awk -F, 'BEGIN{OFS=","} {for(i=1;i<=NF;i++) if($i=="") $i="-"; print}' "$HISTORY" \
    | column -s, -t
}

cmd_chart() {
  [[ -f "$HISTORY" ]] || die "no history yet for subject '$SUBJECT' — run a session first"
  local out
  out=$(FACEAGE_RESULTS="$RESULTS_DIR" FACEAGE_SUBJECT_LABEL="$SUBJECT" \
        python3 "$REPO/tools/faceage_chart.py") || die "could not build the tracker"
  info "Tracker for '$SUBJECT': $out"
  command -v open >/dev/null && open "$out"
}

# Recording a protocol failure. The ordering is the whole point: this is meant
# to be run before `faceage run`, so the decision cannot be influenced by the
# number. Refuses once the session has been scored, for exactly that reason.
cmd_invalidate() {
  local session="${1:-}" reason="${2:-}"
  [[ -n "$session" ]] || die "usage: faceage invalidate YYYY-MM-DD \"reason\" [--force]"
  [[ "$session" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "session must be YYYY-MM-DD"
  [[ -n "$reason" ]] || die "a reason is required (§1 pre-registration)"
  case "$reason" in *,*) die "reason cannot contain a comma (CSV)";; esac

  local force=0
  [[ "${3:-}" == "--force" ]] && force=1

  mkdir -p "$RESULTS_DIR"
  local vfile="$RESULTS_DIR/session_validity.csv"
  [[ -f "$vfile" ]] || echo 'session_date,valid,reason,recorded_at' > "$vfile"

  if grep -q "^$session," "$vfile" 2>/dev/null; then
    die "session $session already has a validity record in $vfile"
  fi

  if [[ -f "$HISTORY" ]] && grep -q "^$session," "$HISTORY" 2>/dev/null; then
    if [[ "$force" -eq 0 ]]; then
      die "session $session has ALREADY BEEN SCORED.
Invalidating it now is not an exclusion, it is discarding a result after seeing
it (§1). If the protocol failure was genuinely identified before the score was
looked at, re-run with --force and say so in the reason."
    fi
    warn "Recording a failure for an already-scored session, as forced."
  fi

  printf '%s,no,%s,%s\n' "$session" "$reason" "$(date +%FT%T)" >> "$vfile"
  info "Recorded protocol failure for $session: $reason"
  info "It will be excluded from the analysis, with this reason shown."
}

cmd_analysis() {
  [[ -f "$HISTORY" ]] || die "no history yet for subject '$SUBJECT' — run a session first"
  python3 "$REPO/tools/faceage_analysis.py" --results "$RESULTS_DIR" "$@"
}

cmd_subjects() {
  local base="$DATA/subjects"
  [[ -d "$base" ]] || die "no subjects yet — run a session first"
  printf '%-16s %9s %9s %10s\n' SUBJECT SESSIONS LOGGED LATEST
  local d name ns rows latest
  for d in "$base"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    ns=$(find "$d/sessions" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    if [[ -f "$d/results/faceage_history.csv" ]]; then
      rows=$(( $(wc -l < "$d/results/faceage_history.csv") - 1 ))
      latest=$(tail -1 "$d/results/faceage_history.csv" | cut -d, -f7)
    else
      rows=0; latest="—"
    fi
    printf '%-16s %9s %9s %10s\n' "$name" "$ns" "$rows" "$latest"
  done
}

cmd_doctor() {
  printf 'host arch        : %s\n' "$(uname -m)"
  printf 'colima           : %s\n' "$(command -v colima >/dev/null && colima status 2>&1 | head -1 || echo 'NOT INSTALLED')"
  printf 'docker           : %s\n' "$(command -v docker >/dev/null && docker --version || echo 'NOT INSTALLED')"
  printf 'image %-11s: %s\n' "$IMAGE" "$(docker image inspect "$IMAGE" >/dev/null 2>&1 && echo present || echo MISSING)"
  if [[ -f "$MODEL" ]]; then
    local sha; sha=$(shasum -a 256 "$MODEL" | cut -d' ' -f1)
    printf 'weights          : present, sha256 %s %s\n' "${sha:0:16}..." \
      "$([[ "$sha" == "$WEIGHTS_SHA" ]] && echo '(matches release v1 ✓)' || echo '(UNEXPECTED HASH)')"
  else
    printf 'weights          : MISSING (%s)\n' "$MODEL"
  fi
  printf 'photo root       : %s\n' "$DATA"
  printf 'active subject   : %s\n' "$SUBJECT"
  printf 'sessions found   : %s\n' "$(find "$SESSIONS_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  printf 'history rows     : %s\n' "$([[ -f "$HISTORY" ]] && echo $(($(wc -l < "$HISTORY")-1)) || echo 0)"
}

migrate_legacy
sub="${1:-}"; [[ $# -gt 0 ]] && shift || true
parse_common "$@"
set -- ${ARGS[@]+"${ARGS[@]}"}

case "$sub" in
  run)      cmd_run "$@" ;;
  validate) cmd_validate "$@" ;;
  history)  cmd_history ;;
  chart)    cmd_chart ;;
  gate)     cmd_analysis --sigma "$@" ;;
  trend)    cmd_analysis --trend --luma "$@" ;;
  analyse|analyze) cmd_analysis --all "$@" ;;
  invalidate) cmd_invalidate "$@" ;;
  subjects) cmd_subjects ;;
  build)    cmd_build ;;
  doctor)   cmd_doctor ;;
  *) cat <<USAGE
FaceAge — local scoring pipeline

  faceage run                score today's session folder
  faceage run YYYY-MM-DD     score that session folder
  faceage run FOLDER         score a folder of photos directly
  faceage run FILE...        stage those photos into today's session and score
  faceage chart              build + open the visual tracker dashboard
  faceage history            print the longitudinal series

  faceage gate               §4 repeatability: sigma + the build/no-build call
  faceage trend              §3 OLS slope + 95% CI, and the §6 luma check
  faceage analyse            all of the pre-registered analysis
  faceage invalidate DATE "reason"
                             record a protocol failure BEFORE scoring (§1)
  faceage subjects           list everyone with data on this machine
  faceage validate [tol]     re-run validation against the authors' CSV
  faceage build              (re)build the linux/amd64 container image
  faceage doctor             check environment, weights hash, session count

Everyone's data is kept separate. Your own is subject '$DEFAULT_SUBJECT'.

  faceage run --subject jackie ~/Desktop/jackie/*.jpg
  faceage chart --subject jackie
  faceage run --no-log ~/Desktop/oneoff.jpg     # score, but log nothing

Extra flags after 'run' pass through, e.g.
  faceage run --include-flagged
  faceage run --min-face-fill 0.6
USAGE
    exit 1 ;;
esac
